# Reference list of EVERY environment variable. Copy the right part into the right file:
#   backend/.env   <- the Supabase secret lives ONLY here (and in the hosting dashboard)
#   frontend/.env  <- only the public backend URL

# ---------- backend/.env ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-SECRET-SERVICE-ROLE-KEY
# Comma-separated list of frontend addresses allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional:
LOG_FILE=app.log
LOG_LEVEL=INFO

# ---------- frontend/.env ----------
VITE_API_BASE_URL=http://127.0.0.1:8000
