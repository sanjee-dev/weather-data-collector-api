# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit .env. The SUPABASE_KEY is a SECRET: backend only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-SECRET-SERVICE-ROLE-KEY

# Frontend addresses allowed to call this API (comma-separated, no trailing slash).
# After you deploy the frontend, add its https:// address here too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
LOG_FILE=app.log
LOG_LEVEL=INFO
